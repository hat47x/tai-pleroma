{
  "schema": "eki.task-request/v1",
  "executor": {"id": "dev.example.transform", "version_constraint": "^1"},
  "inputs": [],
  "parameters": {"mode": "old-notice-check", "scope": "all-rooms"},
  "resources": {
    "cpu_millis": 800,
