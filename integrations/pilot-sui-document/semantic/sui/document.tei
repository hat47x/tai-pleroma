namespace sui

data Document {
    attribute documentId type std.identifier
    attribute title type std.text
    attribute digest type std.text
}

data Card {
    attribute cardId type std.identifier
    attribute documentId type std.identifier
    attribute text type std.text
}

data Island {
    attribute islandId type std.identifier
    attribute documentId type std.identifier
    attribute title type std.text
}

data Edge {
    attribute edgeId type std.identifier
    attribute fromId type std.identifier
    attribute toId type std.identifier
    attribute relation type std.code
    attribute fromKind type std.code
    attribute toKind type std.code
}
