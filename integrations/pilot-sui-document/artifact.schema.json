{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tai-pleroma.example/schemas/tei-documentv1-projection-v0.schema.json",
  "title": "TEI documentv1 projection artifact v0",
  "type": "object",
  "required": ["schema", "contract", "source", "document"],
  "properties": {
    "schema": {"const": "tai.reference.tei-documentv1-projection/v0"},
    "contract": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["teiCommit", "contracts"],
      "properties": {
        "teiCommit": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["active", "revoked", "expired"],
          "description": "Source lifecycle as declared by the producer. Absent or unknown means the consumer treats it as unknown, never as active."
        },
        "statusReason": {"type": "string", "minLength": 1},
        "documentRevision": {"type": "string", "minLength": 1},
        "observedAt": {"type": "string", "format": "date-time"},
        "contracts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "contractId",
              "contractVersion",
              "contractDigest",
              "sourceDigest",
              "cases"
            ],
            "properties": {
              "contractId": {"type": "string", "minLength": 1},
              "contractVersion": {"type": "string", "minLength": 1},
              "contractDigest": {"type": "string", "pattern": "^sha256:"},
              "sourceDigest": {"type": "string", "pattern": "^sha256:"},
              "cases": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "description": "Document-level disclosure declared by the producer. Absent means the consumer applies no document-level restriction; restricted means it returns nothing at all (not even entity kind or count).",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["public", "internal", "restricted"]
        },
        "policyRef": {"type": "string", "minLength": 1}
      }
    },
    "document": {
      "type": "object",
      "required": ["document", "cards", "islands", "edges", "affiliations"],
      "properties": {
        "document": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "title": {"type": "string"},
            "readingOrder": {"type": "array", "items": {"type": "string"}}
          }
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "x", "y"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "text": {"type": "string"},
              "x": {"type": "number"},
              "y": {"type": "number"},
              "sources": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "islands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "cardIds"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "cardIds": {"type": "array", "items": {"type": "string"}},
              "title": {"type": "string"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "fromId", "toId", "type", "fromKind", "toKind"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "fromId": {"type": "string", "minLength": 1},
              "toId": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "fromKind": {"enum": ["card", "island"]},
              "toKind": {"enum": ["card", "island"]}
            }
          }
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "cardId", "islandId"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "cardId": {"type": "string", "minLength": 1},
              "islandId": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
