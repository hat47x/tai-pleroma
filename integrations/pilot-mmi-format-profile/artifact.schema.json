{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tai-pleroma.example/schemas/tei-mmi-format-profile-projection-v0.schema.json",
  "title": "TEI MMI format profile projection artifact v0",
  "type": "object",
  "required": ["schema", "contract", "source", "profile"],
  "properties": {
    "schema": {"const": "tai.reference.tei-mmi-format-profile-projection/v0"},
    "contract": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["teiCommit", "contract"],
      "properties": {
        "teiCommit": {"type": "string", "minLength": 1},
        "contract": {
          "type": "object",
          "required": ["contractId", "contractVersion", "contractDigest", "sourceDigest", "cases"],
          "properties": {
            "contractId": {"type": "string", "minLength": 1},
            "contractVersion": {"type": "string", "minLength": 1},
            "contractDigest": {"type": "string", "pattern": "^sha256:"},
            "sourceDigest": {"type": "string", "pattern": "^sha256:"},
            "cases": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "label",
        "purpose",
        "status",
        "featureVersion",
        "sourceProfileId"
      ],
      "properties": {
        "schemaVersion": {"const": "mmi-format-profile-v1"},
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "approved"]},
        "featureVersion": {"type": "string", "minLength": 1},
        "sourceProfileId": {"type": "string", "minLength": 1}
      }
    }
  }
}
