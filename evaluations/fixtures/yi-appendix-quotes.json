  "schema": "tai.evaluation.yi-appendix-quotes/v0",
  "source": "周易の序卦伝・雑卦伝（Wikisource、2026-11-01取得）。句読点は資料の表記に合わせた。",
  "quotes": [
    {
      "section": "雑卦伝",
      "quote": "否泰、反其類也"
    },
    {
      "section": "雑卦伝",
      "quote": "損益、盛衰之始也"
    },
    {
      "section": "雑卦伝",
      "quote": "萃聚、而升不來也"
    },
    {
      "section": "雑卦伝",
      "quote": "井通、而困相遇也"
    },
    {
      "section": "雑卦伝",
      "quote": "革去故也、鼎取新也"
    },
    {
      "section": "序卦伝",
      "quote": "泰者通也。物不可以終通、故受之以否。"
    },
    {
      "section": "序卦伝",
      "quote": "損而不已、必益、故受之以益。益而不已、必決、故受之以夬。"
    },
    {
      "section": "序卦伝",
      "quote": "萃者聚也。聚而上者、謂之升、故受之以升。升而不已、必困、故受之以困。困乎上者、必反下、故受之以井。井道不可不革、故受之以革。革物者莫若鼎、故受之以鼎。"
    }
  ]
}
