      "oracleSingle": "7192385c3c0605de55bb9476ce1d90748190ecb32a8eed7f5207b30cf6a1fe89",
      "doubleSha": "3e6f500e47d4e783b851016489b9938390d7a6a8f5b1b00c95ab40dc18f000b9",
      "expected": "single-sha-only"
