    {
      "id": "SK-TB09",
      "kind": "disclosure",
      "privateIssuerPresentS0": false,
      "privateIssuerPresentS1": true,
      "publicProjectionS0": "public-tools-v1",
      "publicProjectionS1": "public-tools-v1",
      "expected": "indistinguishable-to-public-consumer"
    }
  ],
  "caveats": [
    "This is a public fixture with expected outcomes, not an independent/sealed model evaluation.",
    "Legacy compatibility is only a candidate when explicitly approved by EKI Owner and existing CA/Registry checks pass.",
    "Hash vector uses six arbitrary synthetic bytes (not a parseable CA certificate); cryptographic comparison is arithmetic only.",
    "Source-static EKI #466/#467 findings do not establish successful mTLS exploit or fixed production behavior.",
    "No real EKI mTLS, OS sandbox, Skill, remote LLM, Provider effects or Owner acceptance has been tested."
  ]
