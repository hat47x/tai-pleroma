      "kind": "trust",
      "installed": "never",
      "compatApproved": true,
      "legacyCAAndRegistryValid": true,
      "latest": "not-configured",
      "expected": "legacy-path-eligible"
    },
    {
      "id": "SK-TB02",
      "kind": "trust",
      "installed": "ever",
      "compatApproved": false,
      "legacyCAAndRegistryValid": true,
      "latest": "ok",
      "currentIssuerAllowed": true,
      "expected": "proceed-to-other-host-checks"
    },
    {
      "id": "SK-TB03",
      "kind": "trust",
      "installed": "ever",
      "legacyCAAndRegistryValid": true,
      "latest": "ok",
